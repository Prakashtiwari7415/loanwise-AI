ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
# LLM Provider Configuration (gemini or openai)
LLM_PROVIDER=gemini
# Gemini API Key (or use LLM_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_api_key_here
# Gemini OpenAI-compatible base URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model: gemini-1.5-flash (recommended), gemini-2.0-flash, or gpt-4o-mini for openai
LLM_MODEL=gemini-1.5-flash
# Optional OpenAI fallback
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_CALLS=5
LLM_MAX_TURNS=5
LLM_MAX_INPUT_LENGTH=4000

POSTGRES_DB=loanwise
POSTGRES_USER=loanwise
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://loanwise:replace-with-a-local-development-password@localhost:5432/loanwise
