# ==============================================================================
# LoanWise AI — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# For cloud deployment (Render & Neon), configure these in your provider dashboards.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & CORS
# ------------------------------------------------------------------------------
# Set to 'development' locally, and 'production' on Render Web Service.
# When 'production', wildcard CORS ('*') is rejected and DATABASE_URL is strictly required.
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins (NO trailing slashes, NO wildcard in production).
# Local default: http://localhost:5173,http://127.0.0.1:5173
# Render production example: https://loanwise-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Listening port (Render automatically provides $PORT; defaults to 8000 locally)
PORT=8000

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Render Static Site / Vite)
# ------------------------------------------------------------------------------
# Public API base URL used by the React frontend to reach the backend.
# Local development: http://127.0.0.1:8000
# Render Static Site build env: https://loanwise-backend.onrender.com (replace with your Render Web Service URL)
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Neon PostgreSQL / Local Postgres)
# ------------------------------------------------------------------------------
# Local Docker Postgres defaults:
POSTGRES_DB=loanwise
POSTGRES_USER=loanwise
POSTGRES_PASSWORD=replace_with_local_dev_password

# Database Connection URL:
# - Local Docker Compose:
#   DATABASE_URL=postgresql+psycopg://loanwise:replace_with_local_dev_password@localhost:5432/loanwise
# - Neon Serverless PostgreSQL:
#   Copy the connection string from your Neon Console (Dashboard -> Connection Details).
#   Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
#   (LoanWise automatically normalizes 'postgresql://' and 'postgres://' to 'postgresql+psycopg://' and enforces sslmode=require)
DATABASE_URL=postgresql+psycopg://loanwise:replace_with_local_dev_password@localhost:5432/loanwise

# ------------------------------------------------------------------------------
# 4. AI ASSISTANT / LLM CONFIGURATION (Gemini 2.5 Flash)
# ------------------------------------------------------------------------------
# LLM Provider: 'gemini' (recommended) or 'openai'
LLM_PROVIDER=gemini

# Primary Google Gemini API key (from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_api_key_here

# OpenAI-compatible Gemini endpoint (default is Google AI Studio OpenAI-compatible beta)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Assistant model (gemini-2.5-flash is optimized for fast tool calls and RAG)
LLM_MODEL=gemini-2.5-flash

# Optional fallback OpenAI API Key (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Assistant safety and guardrail limits
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_TOOL_CALLS=5
LLM_MAX_TURNS=5
LLM_MAX_INPUT_LENGTH=4000
